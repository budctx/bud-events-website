# Server-only settings. Leave disabled until the dedicated sandbox is configured.
BUD_BACKEND_ENABLED=false
BUD_AUTH_ENABLED=false
BUD_APP_ORIGIN=https://budteam.net
SUPABASE_URL=https://cepmvqqrjcvhyzszqand.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BUD_AUTH_COOKIE_SECRET=
# Mandatory distributed limiter before enabling Auth/host; VERCEL is supplied by Vercel.
BUD_RATE_LIMIT_ENABLED=false
BUD_RATE_LIMIT_SECRET=
# Sandbox-only adapter. No live payments are supported or activated.
BUD_WHOP_SANDBOX_ENABLED=false
WHOP_ENVIRONMENT=sandbox
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_WEBHOOK_SECRET=
WHOP_SANDBOX_COMPANY_ID=
WHOP_SANDBOX_PRODUCT_ID=
WHOP_SANDBOX_PLAN_ID=
WHOP_SANDBOX_CURRENCY=
WHOP_SANDBOX_AMOUNT_MINOR=
# Production routes require explicit live selection and independent controls; defaults stay closed.
# Existing installed secrets do not activate sales. Existing project preparation is approved; backup/review gates remain.
WHOP_PRODUCTION_API_KEY=
WHOP_PRODUCTION_WEBHOOK_SECRET=
WHOP_PRODUCTION_COMPANY_ID=
WHOP_PRODUCTION_PLAN_ID=
WHOP_PRODUCTION_PRODUCT_ID=
WHOP_PRODUCTION_CURRENCY=sar
# Owner-approved official one-time price.
WHOP_PRODUCTION_AMOUNT_MINOR=1800
WHOP_PRODUCTION_WEBHOOK_API_VERSION=
BUD_WHOP_PRODUCTION_ENABLED=false
# Runtime routes default to Sandbox. Live selection is server-only and never activates SQL controls.
BUD_COMMERCE_MODE=sandbox
# Independent audience opt-in for verified customers; pilot remains limited to the owner.
BUD_PUBLIC_COMMERCE_ENABLED=false
# Independent signed intake/worker drain; new orders require both flags.
BUD_WHOP_PRODUCTION_PROCESSING_ENABLED=false
# Independent live host control; pause NEW starts with SQL host_enabled while preserving resume.
BUD_LIVE_HOST_ENABLED=false
BUD_LIVE_RECEIPTS_ENABLED=false
BUD_PAYMENT_WORKER_ENABLED=false
# Server-only worker/monitor authentication. Never put it in a URL or client variable.
CRON_SECRET=
BUD_WHOP_PRODUCTION_MODE=pilot
BUD_WHOP_PILOT_HOST_ID=
# Independent owner-only, read-only provider inspection. Does not enable checkout or credit.
BUD_WHOP_PREFLIGHT_ENABLED=false
# Independent owner-only POST /payment_quotes for an SA preview. No payment or checkout.
BUD_WHOP_QUOTE_PREFLIGHT_ENABLED=false
# Temporary delivery/signature check; refuses every enabled financial flag. No enqueue or payment lookup.
BUD_WHOP_WEBHOOK_VERIFY_ONLY_ENABLED=false
