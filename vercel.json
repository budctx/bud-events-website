{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/payment-worker.ts": {
      "maxDuration": 60
    },
    "api/payment-reconcile.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/payment-worker",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/payment-reconcile",
      "schedule": "5 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bud-events-website.vercel.app"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "screen",
          "value": "local"
        }
      ],
      "destination": "https://budteam.net/",
      "permanent": false
    }
  ]
}
